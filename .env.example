# ─── Dashboard ────────────────────────────────────────────────────────────────
# Public base URL. Used for OAuth redirects and bot invite links.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Force the demo dataset even if Supabase is configured.
# Leave unset (or 0) to run live.
# NEXT_PUBLIC_DEMO_MODE=1

# ─── Discord ──────────────────────────────────────────────────────────────────
# https://discord.com/developers/applications → your app → OAuth2
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Bot tab → Reset Token. Server-side only, never exposed to the browser.
DISCORD_BOT_TOKEN=

# Set to 1 on serverless hosts that cannot keep a gateway socket open
# (then run the bot as a separate worker/process).
# BOT_DISABLED=1

# ─── Supabase ─────────────────────────────────────────────────────────────────
# Project settings → API. Without these the app runs in demo mode.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key — bypasses RLS. Only used by the bot, scheduler and sync job.
SUPABASE_SERVICE_ROLE_KEY=

# ─── Cron ─────────────────────────────────────────────────────────────────────
# Shared secret required by POST /api/scheduler/tick (Vercel Cron sends it).
CRON_SECRET=
